<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screenBackground"
    tools:context=".ui.login.LoginFragment">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/featuredPostsRecyclerView"
        android:layout_width="0dp"
        android:layout_height="340dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="@dimen/screen_horizontal_padding"
        android:paddingEnd="76dp"
        android:paddingTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:itemCount="3"
        tools:listitem="@layout/item_featured_post" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/loginSheetCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="-32dp"
        app:cardBackgroundColor="@color/sheetBackground"
        app:cardCornerRadius="42dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/featuredPostsRecyclerView">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingTop="12dp"
            android:paddingEnd="32dp"
            android:paddingBottom="24dp">

            <View
                android:layout_width="48dp"
                android:layout_height="5dp"
                android:background="@drawable/bg_sheet_handle"
                android:alpha="0.1" />

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_logo_tile">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/app_icon_content_description"
                    android:src="@drawable/ic_app_mark" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tripTitleTextView"
                    style="@style/TextAppearance.Tripli.TitleDark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_trip"
                    android:textSize="32sp" />

                <TextView
                    android:id="@+id/liTitleTextView"
                    style="@style/TextAppearance.Tripli.TitleAccent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_li"
                    android:textSize="32sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/subtitleTextView"
                style="@style/TextAppearance.Tripli.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/login_subtitle"
                android:textAlignment="center"
                android:lineSpacingMultiplier="1.2"
                android:textColor="#707070" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/signInButton"
                style="@style/Widget.Tripli.GoogleButton"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginTop="36dp"
                android:text="@string/sign_in_with_google"
                android:textAllCaps="false"
                android:textColor="#2D3139"
                app:icon="@drawable/ic_google_g"
                app:iconGravity="textStart"
                app:iconPadding="16dp"
                app:strokeColor="#EAEAEA"
                android:letterSpacing="0.01" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/signInProgressIndicator"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="16dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/accentBlue" />

            <TextView
                android:id="@+id/termsTextView"
                style="@style/TextAppearance.Tripli.Terms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textAlignment="center"
                android:textColor="#A0A0A0"
                tools:text="By continuing, you agree to our Terms of Service and Privacy Policy." />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
