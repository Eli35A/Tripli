<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screenBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Top bar -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/screenBackground">

            <TextView
                android:id="@+id/tvCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:text="Cancel"
                android:textColor="@color/textSecondary"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Trip Post"
                android:textColor="@color/textPrimary"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Photo upload area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_dashed_border"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Placeholder (shown when no images selected) -->
            <LinearLayout
                android:id="@+id/layoutPhotoPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_camera_add"
                    android:contentDescription="Add photos" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Add Photos"
                    android:textColor="@color/textPrimary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Upload highlights from your trip"
                    android:textColor="@color/textSecondary"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Thumbnails (shown after images selected) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSelectedImages"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                android:clipToPadding="false"
                android:paddingStart="4dp" />

            <!-- Select / Add More button (always visible) -->
            <TextView
                android:id="@+id/tvSelectImages"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_select_images_btn"
                android:paddingHorizontal="28dp"
                android:paddingVertical="10dp"
                android:text="Select Images"
                android:textColor="@color/accentBlue"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Where did you go? -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="24dp"
            android:text="Where did you go?"
            android:textColor="@color/textPrimary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_location_pin"
                android:contentDescription="Location pin" />

            <EditText
                android:id="@+id/etLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Kyoto, Japan"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="@color/textPrimary"
                android:textColorHint="@color/textSecondary"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- Rate your experience -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="24dp"
            android:text="Rate your experience"
            android:textColor="@color/textPrimary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivStar1"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_star_filled"
                android:contentDescription="Star 1" />

            <ImageView
                android:id="@+id/ivStar2"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_star_filled"
                android:contentDescription="Star 2" />

            <ImageView
                android:id="@+id/ivStar3"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_star_filled"
                android:contentDescription="Star 3" />

            <ImageView
                android:id="@+id/ivStar4"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_star_filled"
                android:contentDescription="Star 4" />

            <ImageView
                android:id="@+id/ivStar5"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:alpha="0.3"
                android:src="@drawable/ic_star_filled"
                android:contentDescription="Star 5" />

            <TextView
                android:id="@+id/tvRatingValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="4.0"
                android:textColor="@color/textSecondary"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- Write a review -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="24dp"
            android:text="Write a review"
            android:textColor="@color/textPrimary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etReview"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_field"
            android:gravity="top|start"
            android:hint="Share your experience about this trip...\nWhat was the best part? Any tips for future travelers?"
            android:inputType="textMultiLine"
            android:padding="14dp"
            android:textColor="@color/textPrimary"
            android:textColorHint="@color/textSecondary"
            android:textSize="14sp" />

        <!-- Categories -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="24dp"
            android:text="Categories"
            android:textColor="@color/textPrimary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="10dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="8dp"
            app:singleLine="false">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAdventure"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="#Adventure"
                android:textSize="14sp"
                app:chipBackgroundColor="@color/accentBlue"
                app:chipCornerRadius="24dp"
                app:chipStrokeWidth="0dp"
                android:textColor="@color/white" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFood"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#Food"
                android:textSize="14sp"
                app:chipBackgroundColor="@color/white"
                app:chipCornerRadius="24dp"
                app:chipStrokeColor="#DEE4EA"
                app:chipStrokeWidth="1.5dp"
                android:textColor="@color/textPrimary" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRelaxation"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#Relaxation"
                android:textSize="14sp"
                app:chipBackgroundColor="@color/white"
                app:chipCornerRadius="24dp"
                app:chipStrokeColor="#DEE4EA"
                app:chipStrokeWidth="1.5dp"
                android:textColor="@color/textPrimary" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCulture"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#Culture"
                android:textSize="14sp"
                app:chipBackgroundColor="@color/white"
                app:chipCornerRadius="24dp"
                app:chipStrokeColor="#DEE4EA"
                app:chipStrokeWidth="1.5dp"
                android:textColor="@color/textPrimary" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAdd"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Add"
                android:textSize="14sp"
                app:chipBackgroundColor="@color/white"
                app:chipCornerRadius="24dp"
                app:chipStrokeColor="#DEE4EA"
                app:chipStrokeWidth="1.5dp"
                android:textColor="@color/textSecondary" />

        </com.google.android.material.chip.ChipGroup>

        <!-- Share Post button -->
        <TextView
            android:id="@+id/tvSharePost"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_share_post_btn"
            android:gravity="center"
            android:text="Share Post  ➤"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
