<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screenBackground">

    <!-- ── Header ── -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_profile_header">

    <LinearLayout
        android:id="@+id/headerContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="28dp"
        android:paddingBottom="20dp"
        android:gravity="center_horizontal">

        <!-- Loading spinner (shown while profile loads) -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/profileLoadingIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/white"
            app:indicatorSize="24dp" />

        <!-- Profile picture (circular card) — tap to expand -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/profileImageCard"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="45dp"
            app:cardElevation="6dp"
            app:strokeColor="@color/white"
            app:strokeWidth="2dp">

            <ImageView
                android:id="@+id/profileImageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@null"
                android:src="@drawable/ic_profile_placeholder" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Username — below picture -->
        <TextView
            android:id="@+id/profileNameTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/textPrimary"
            android:textSize="20sp"
            android:textStyle="bold|italic"
            android:fontFamily="serif"
            android:letterSpacing="0.02"
            tools:text="Maya Katsir" />

        <!-- Decorative underline below name -->
        <View
            android:layout_width="60dp"
            android:layout_height="2dp"
            android:layout_marginTop="5dp"
            android:background="@color/accentBlue" />

        <!-- Bio -->
        <TextView
            android:id="@+id/profileBioTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:gravity="center"
            android:textColor="@color/textPrimary"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone"
            tools:text="Travel enthusiast ✈️ | Exploring one city at a time"
            tools:visibility="visible" />

    </LinearLayout>

    <!-- Animated leaves background — constrained to content height, rendered behind via translationZ -->
    <com.example.tripli.features.profile.LeafAnimationView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/headerContent"
        android:layout_alignBottom="@id/headerContent"
        android:translationZ="-1dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/logoutButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="6dp"
        android:text="Sign out"
        android:textSize="11sp"
        android:textColor="@color/textPrimary"
        android:fontFamily="serif"
        android:textStyle="italic"
        android:letterSpacing="0.03"
        app:icon="@drawable/ic_logout"
        app:iconSize="13dp"
        app:iconTint="@color/textPrimary"
        app:iconGravity="start"
        app:iconPadding="3dp"
        android:contentDescription="Sign out" />

    </RelativeLayout>

    <!-- ── Edit Profile button ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        android:background="@color/screenBackground">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/editProfileButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Edit Profile"
            android:textSize="12sp"
            android:textColor="@color/white"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            app:backgroundTint="@color/profileAccent"
            app:cornerRadius="18dp"
            app:icon="@drawable/ic_profile"
            app:iconSize="14dp"
            app:iconTint="@color/white"
            app:iconPadding="4dp" />

    </LinearLayout>

    <!-- ── Tab layout ── -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/profileTabLayout"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/screenBackground"
        app:tabTextColor="@color/textSecondary"
        app:tabSelectedTextColor="@color/accentBlue"
        app:tabIndicatorColor="@color/accentBlue"
        app:tabIndicatorHeight="2dp"
        app:tabTextAppearance="@style/TextAppearance.Material3.LabelLarge" />

    <!-- ── ViewPager2 (fills rest of screen) ── -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/profileViewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
