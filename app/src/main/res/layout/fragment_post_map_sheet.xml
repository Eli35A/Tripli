<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/sheetBackground">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_sheet_handle" />

    <ImageView
        android:id="@+id/sheetPostImage"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        tools:background="@color/screenBackground" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/sheetTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/textPrimary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp"
                tools:text="Hidden Gem in Bali" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_star_filled"
                android:tint="@color/starGold"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/sheetRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="@color/textPrimary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="4.8" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/ic_location_pin"
                android:tint="@color/accentBlue"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/sheetLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="@color/accentBlue"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Ubud, Bali" />

        </LinearLayout>

        <TextView
            android:id="@+id/sheetAuthor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/textSecondary"
            android:textSize="12sp"
            tools:text="by Jane Cooper · 2 hours ago" />

        <TextView
            android:id="@+id/sheetCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/textPrimary"
            android:textSize="14sp"
            android:maxLines="3"
            android:ellipsize="end"
            tools:text="Found this incredible spot away from the crowds. The hike down was worth every step!" />

        <TextView
            android:id="@+id/sheetHashtags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:textColor="@color/accentBlue"
            android:textSize="13sp"
            tools:text="#bali #travel #nature" />

    </LinearLayout>

</LinearLayout>
