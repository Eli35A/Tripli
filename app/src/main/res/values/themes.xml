<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Tripli" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/accentBlue</item>
        <item name="colorSecondary">@color/accentBlue</item>
        <item name="android:statusBarColor">@color/screenBackground</item>
        <item name="android:navigationBarColor">@color/sheetBackground</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="colorSurface">@color/sheetBackground</item>
        <item name="colorOnSurface">@color/textPrimary</item>
        <item name="android:colorBackground">@color/screenBackground</item>
    </style>

    <style name="TextAppearance.Tripli.TitleDark" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">28sp</item>
    </style>

    <style name="TextAppearance.Tripli.TitleAccent" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/accentBlue</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">28sp</item>
    </style>

    <style name="TextAppearance.Tripli.Subtitle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/textSecondary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="TextAppearance.Tripli.Terms" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/termsText</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="TextAppearance.Tripli.Location" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/locationText</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Tripli.Quote" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="TextAppearance.Tripli.Author" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/authorText</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.Tripli.GoogleButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/googleButtonStroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="backgroundTint">@color/white</item>
        <item name="android:textColor">@color/googleButtonText</item>
        <item name="android:textSize">16sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

</resources>
