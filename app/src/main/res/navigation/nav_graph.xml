<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.tripli.ui.login.LoginFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_login">

        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:launchSingleTop="true"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.tripli.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/mapFragment"
        android:name="com.example.tripli.ui.PlaceholderFragment"
        android:label="Map"
        tools:layout="@layout/fragment_placeholder">
        <argument
            android:name="title"
            android:defaultValue="Map" />
    </fragment>

    <fragment
        android:id="@+id/addPostFragment"
        android:name="com.example.tripli.ui.PlaceholderFragment"
        android:label="Add Post"
        tools:layout="@layout/fragment_placeholder">
        <argument
            android:name="title"
            android:defaultValue="Add Post" />
    </fragment>

    <fragment
        android:id="@+id/welcomeFragment"
        android:name="com.example.tripli.ui.welcome.WelcomeFragment"
        android:label="@string/welcome_title"
        tools:layout="@layout/fragment_welcome">

        <argument
            android:name="uid"
            android:defaultValue=""
            app:argType="string" />

        <action
            android:id="@+id/action_welcomeFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:launchSingleTop="true"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>
</navigation>
